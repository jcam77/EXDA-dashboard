#!/usr/bin/env bash
set -euo pipefail

APP="${1:-}"
ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
OS_NAME="$(uname -s 2>/dev/null || echo unknown)"
# The launchers pick and set up the Python environment themselves
# (.venv-mac on macOS, .venv-win on Windows, .venv-linux on Linux).

VERSION="$(git -C "$ROOT_DIR" describe --tags --always 2>/dev/null || echo "unknown")"
BRANCH="$(git -C "$ROOT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")"
echo "EXDA version: $VERSION (branch: $BRANCH)"

if [[ -z "$APP" ]]; then
  echo "Usage: run <appName>"
  echo "Examples:"
  echo "  run EXDA"
  echo "  run exda"
  echo "  run dashboard"
  exit 1
fi

case "$APP" in
  EXDA|exda|dashboard|EXDA-dashboard|v0.3|0.3)
    cd "$ROOT_DIR"
    case "$OS_NAME" in
      Linux)
        exec bash "$ROOT_DIR/Run-EXDA-LINUX.sh"
        ;;
      Darwin)
        exec bash "$ROOT_DIR/Run-EXDA-MAC.command"
        ;;
      *)
        npm run dev
        ;;
    esac
    ;;
  *)
    echo "Unknown app: $APP"
    echo "Supported: EXDA, exda, dashboard"
    exit 1
    ;;
 esac
